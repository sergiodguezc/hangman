# Local fallback is 3001. Hosting platforms normally provide PORT automatically.
PORT=3001

# Optional server bind address. Production defaults to 0.0.0.0.
HOST=0.0.0.0

# Optional only for split-origin deployments. Leave unset for same-origin production.
# CLIENT_ORIGIN=https://frontend.example.com
# VITE_SERVER_URL=https://server.example.com
